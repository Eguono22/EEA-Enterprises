{
  "name": "eea-enterprises",
  "version": "1.1.0",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "eas-build-pre-install": "rm -rf .expo && mkdir -p .expo && chmod -R u+rwX .expo",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit:android": "eas submit --platform android --profile production-android",
    "submit:ios": "eas submit --platform ios --profile production-ios"
  },
  "dependencies": {
    "@sentry/react-native": "~8.28.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.20",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "babel-preset-expo": "~58.0.24"
  },
  "private": true
}
